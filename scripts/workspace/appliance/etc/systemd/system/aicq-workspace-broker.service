[Unit]
Description=AICQ Agent computer broker
Requires=aicq-workspace-firewall.service
After=aicq-workspace-firewall.service

[Service]
Type=simple
User=aicqws
Group=aicqws
Environment=HOME=/home/aicqws
Environment=XDG_RUNTIME_DIR=/run/aicq-workspace/user
UMask=0077
ExecStart=/opt/aicq-workspace/broker.py
Restart=on-failure
RestartSec=2
Delegate=yes

[Install]
WantedBy=multi-user.target
