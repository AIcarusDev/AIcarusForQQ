FROM docker.io/library/ubuntu@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

COPY command-runner.py /usr/local/bin/aicq-command-runner
COPY file-ops.py /usr/local/bin/aicq-file-ops

ARG DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    attempt=1; \
    while :; do \
        rm -f /var/cache/apt/archives/*.deb /var/cache/apt/archives/partial/*; \
        if timeout --signal=TERM 300 apt-get -o Acquire::Retries=5 -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::http::No-Cache=true update \
            && timeout --signal=TERM 1500 apt-get -o Acquire::Retries=5 -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::http::No-Cache=true install -y --no-install-recommends \
                bash build-essential ca-certificates curl wget git openssh-client \
                python3-full python3-dev python3-pip python3-venv \
                jq ripgrep file less nano procps tini \
                tar gzip bzip2 xz-utils zip unzip; then \
            break; \
        fi; \
        if [ "$attempt" -ge 3 ]; then \
            echo "[workspace] System package bootstrap failed after 3 clean downloads" >&2; \
            exit 1; \
        fi; \
        delay=$((attempt * 3)); \
        echo "[workspace][retry] System package download or integrity check failed; discarding cached packages and retrying in ${delay}s (attempt $((attempt + 1))/3)"; \
        dpkg --configure -a || true; \
        sleep "$delay"; \
        attempt=$((attempt + 1)); \
    done; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    python3 -m venv /opt/aicq/venv; \
    attempt=1; \
    while ! timeout --signal=TERM 900 /opt/aicq/venv/bin/python -m pip install --no-cache-dir --retries 5 --timeout 60 --upgrade pip setuptools wheel uv; do \
        if [ "$attempt" -ge 3 ]; then \
            echo "[workspace] Python tool bootstrap failed after 3 clean downloads" >&2; \
            exit 1; \
        fi; \
        delay=$((attempt * 3)); \
        echo "[workspace][retry] Python tool download failed integrity checks; retrying in ${delay}s (attempt $((attempt + 1))/3)"; \
        sleep "$delay"; \
        attempt=$((attempt + 1)); \
    done; \
    chmod 0755 /usr/local/bin/aicq-command-runner /usr/local/bin/aicq-file-ops

ENV VIRTUAL_ENV=/opt/aicq/venv
ENV PATH=/opt/aicq/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/sleep", "infinity"]
