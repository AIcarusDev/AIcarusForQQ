# ==========================================
#  AIcarusForQQ 基本配置
#  (此文件仅供模板参考，请创建 config/config_user.yaml 进行覆盖)
# ==========================================

# ── 1. 模型供应商（统一 OpenAI 兼容）─────────────────────────
#
# API Key 配置方式：
#   A. [推荐] 通过 WebUI 的“模型供应商”页面维护，页面会自动把密钥写入 .env
#   B. 手动在项目根目录 .env 中填写对应的 api_key_env
#
# 这里只维护“供应商”的连接信息：名称 / base_url / api_key_env。
# 各个模型消费点只负责选择 provider 并填写 model。

model_providers:
  siliconflow:
    name: "硅基流动 (SiliconFlow)"
    base_url: "https://api.siliconflow.cn/v1"
    api_key_env: "SILICONFLOW_API_KEY"
  dashscope:
    name: "阿里云百炼 (DashScope)"
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    api_key_env: "DASHSCOPE_API_KEY"
  bigmodel:
    name: "智谱 (BigModel)"
    base_url: "https://open.bigmodel.cn/api/paas/v4"
    api_key_env: "BIGMODEL_API_KEY"
  lmstudio:
    name: "LM Studio（本地）"
    base_url: "http://localhost:1234/v1"
    api_key_env: ""
    requires_api_key: false
    supports_response_format: false

# 当前主模型使用的供应商与模型 ID
provider: "siliconflow"

# --- 模型 ID ---
# 阿里云百炼示例:   "qwen3.5-flash" | "qwen3.5-plus"
# 硅基流动示例:     "Pro/zai-org/GLM-5" | "deepseek-ai/DeepSeek-V3"
# 智谱示例:         "glm-5" | "glm-4-air"
# LM Studio 示例:   "google/gemma-4-27b-it" | 你本地加载的模型 ID
model: "Pro/zai-org/GLM-5"

# ── 显式绑定示例 ────────────────────────────────────────
# 硅基流动 GLM-5:
#   provider: "siliconflow"
#   model: "Pro/zai-org/GLM-5"
#
# 智谱 GLM-5:
#   provider: "bigmodel"
#   model: "glm-5"
#
# 阿里云百炼 Qwen3.5-Flash:
#   provider: "dashscope"
#   model: "qwen3.5-flash"
#
# LM Studio（本地推理服务器）:
#   provider: "lmstudio"
#   model: "gemma-3-27b-it"  # 填 LM Studio 中加载的模型 ID
#   vision: false  # 如果加载的不是 VLM，建议设为 false

# --- 生成参数 ---
generation:
  temperature: 1.0 # 创造性 (0.0 ~ 2.0)
  max_output_tokens: 10000 # 最大输出 token 数
  enable_thinking: true # 思维链开关 (是否传递给 OpenAI 兼容 API)
  advanced_sampling:
    top_p:
      enabled: false
      value: 0.8
    top_k:
      enabled: false
      value: 20
    min_p:
      enabled: false
      value: 0.0
    presence_penalty:
      enabled: false
      value: 1.5
    frequency_penalty:
      enabled: false
      value: 0.0
    repeat_penalty:
      enabled: false
      value: 1.0
  llm_contents_max_rounds: 10 # 意识流喂回模型的最大轮数，最小 6
  cognition_compression_trigger_rounds: 5 # 意识流累计多少轮后触发压缩，最小 3，且必须小于 llm_contents_max_rounds
  world_multimodal_image_limit: 5 # <world> 中最多同时发送的真实多模态图片数；-1 表示不限制
  duplicate_model_response_guard:
    enabled: false
    lookback_rounds: 3
    max_retries: 2
    normalize_whitespace: true
    fallback_sleep_minutes: 30
  final_reminder: true # 连发提醒：bot 连续发多条消息后插入提示块，防止催促对方回复
  # 临时补丁：开启后所有出站图强制压成 JPEG，动图抽 4/9 帧拼九宫格。
  # 仅用于绕过 SiliconFlow 服务端 PIL "Verify image file failed" bug。
  # 换其它 provider（Gemini / 智谱 / OpenAI 等）时建议关闭。
  siliconflow_image_compat: false

# --- 工具协议 ---
tools:
  send_message:
    # array: send_message(messages=[...])，一次调用可顺序发送多条消息（默认，适合不稳定并行/多次 tool call 的模型）
    # single: send_message(segments=[...], quote=...)，一次调用只发送一条消息
    message_shape: "array"

# --- 工具执行前守门 ---
# 仅对 EXTERNALLY_PERCEPTIBLE=True 的工具生效。当工具即将执行时，如果当前 <world>
# 相比模型决策帧发生语义变化，则调用该子模型直接输出 JSON 判断是否仍可执行。
# 若某个外界可感知工具被守门拒绝，本轮后续外界可感知工具也会跳过，普通工具不受影响。
tool_execution_guard:
  enabled: false
  provider: "lmstudio"
  model: "Qwen3-4B-Instruct-2507-GGUF"
  vision: false # 是否继承主 world 切片里的真实多模态图片；需要守门模型支持视觉输入
  generation:
    temperature: 0.2
    max_output_tokens: 512
    enable_thinking: false

# --- LLM 请求快照（不进入普通日志 / Web 日志页） ---
# 保存每次实际发给主模型的完整 request.messages，便于复盘 system / 工具定义 /
# 意识流 / 当前 user prompt。多模态图片不会保存原始 URL 或 base64，只保存 [image]
# 占位、sha256、mime 与大小摘要。
prompt_snapshots:
  enabled: true
  root_dir: "logs/llm_prompts"
  include:
    main_round: true      # 主意识循环请求
    simple_text: false    # 慢思考 / 压缩等纯文本子调用
    forced_tool: false    # 归档等原生 forced tool 子调用
  compress_after_days: 1        # 旧 jsonl 自动 gzip
  bundle_after_days: 14         # 更旧的 gzip 按日期打 tar.gz 包
  delete_after_days: 60         # 超过天数后删除最旧快照文件；0 表示不按天数删除
  max_total_mb: 2048            # 快照目录总上限；0 表示不按总量清理
  maintenance_interval_seconds: 3600

# --- 意识流上下文压缩 ---
# 后台把已经离开热窗口的意识流压缩为一段历史摘要。
# 这里使用独立 provider + model 绑定；未配置时运行时会回退主模型。
cognition_compression:
  provider: "siliconflow"
  model: "Pro/zai-org/GLM-5"
  generation:
    temperature: 0.3
    max_output_tokens: 2000
    enable_thinking: true

# --- 时区 ---
timezone: "Asia/Shanghai"

# --- 模型显示名称（内部可选；未填写时默认等于 model） ---
model_name: "Pro/zai-org/GLM-5"

# --- 速率限制 ---
max_calls_per_minute: 15 # 每分钟最大 LLM 调用次数，达到上限后自动顺延至下一分钟

# --- 聊天上下文窗口 ---
max_context: 10 # 每个会话保留的最大消息条数

# --- 联网搜索 ---
# 默认只使用 Tavily。启用 SearXNG 后，web_search 会先请求 SearXNG；
# SearXNG 不可用或无结果时仍会回退 Tavily。
web_search:
  searxng:
    enabled: false
    base_url: "http://127.0.0.1:8888"
    language: "zh-CN"
    safesearch: 0 # 0=关闭，1=中等，2=严格

# --- 浏览器工具 ---
# 控制 browser_control 注入 <world><browser> 的多模态图片。
# multimodal_image_limit: -1 表示不限制，0 表示不发送浏览器图片，1 表示仅发送浏览器截图。
# annotate_screenshots: 默认关闭；开启后在浏览器截图上叠加红色目标框/点击预览。
browser_control:
  profile_dir: "cache/browser_profile/default"
  multimodal_image_limit: 5
  annotate_screenshots: false

# --- 自我身份信息 ---
self_name: "AIcarus"

# --- 监护人信息（可选，留空则不在 system prompt 中显示）---
guardian:
  name: ""
  id: ""

# --- Prompt 文档路径（相对路径按项目根目录解析） ---
prompt_files:
  persona: "config/persona.md"

# --- 模拟打字速度 ---
# 打字速度倍率，值越大打字越快，延迟越短，封顶时间也同步缩放
# 可选卡点值: 0.5(很慢) / 0.75(慢) / 1.0(标准) / 1.5(快) / 2.0(很快)
typing_speed: 1.0

# --- 服务器 ---
server:
  port: 5000
  debug: true

# --- WebUI 安全 ---
# enabled: true 后访问 WebUI 页面、API 和 WebSocket 需要先登录。
# password_hash 由 WebUI 自动写入，请不要手动填写明文密码。
# skipped_setup: true 表示首次提示中选择了暂不设置密码，适合本地测试。
webui_auth:
  enabled: false
  password_hash: ""
  skipped_setup: false
  session_days: 7

# --- WebUI 更新公告 ---
webui_updates:
  ack_version: ""

# ══════════════════════════════════════════
#  TTS 插件服务端（可选）
#  主程序作为 WebSocket Server，外部 TTS Worker 作为 Client 连接。
# ══════════════════════════════════════════
tts:
  enabled: false
  host: "127.0.0.1"
  port: 8765
  secret_token: ""
  max_concurrent_tasks_per_plugin: 8

# --- 长期记忆 ---
memory:
  max_active: 8 # 历史主动写入（write_memory 工具）的记忆上限；当前记忆主路径未读取
  max_passive: 15 # 历史每轮自动归档的记忆上限；当前 cognition-flow 归档主路径未读取
  auto_archive:
    enabled: true # true = 自动触发记忆归档提取；false = 不触发、不续跑待归档任务
    raw_turn_archive_enabled: false # 是否保留旧的每轮原始聊天窗口归档；默认关闭，主路径使用干净的认知流区间
    # --- 记忆提取专用模型（显式绑定）---
    provider: "siliconflow"
    model: "Pro/zai-org/GLM-5"
    generation:
      temperature: 0.3 # 归档提取模型温度（低温更稳定结构化输出）
      max_output_tokens: 10000 # 归档提取最大输出 token 数
      enable_thinking: true
  processing:
    enabled: false # true = 启用事件结构化与故事线合成共用模型
    event_structuring_enabled: false # 建立新旧事件连接并标注 candidate storyline
    algorithmic_storyline_enabled: false # 维护时按确定性规则生成 storyline
    dry_run: true # true = 维护流程只输出决策/审计，不固化关系
    solidify: false # true = 允许把 candidate storyline 固化到 Storylines 并刷新 summary
    max_candidate_storylines_per_maintenance: 100
    maintenance_timeout_seconds: 300 # 单次记忆维护的内部运行预算；0 = 不限时，只受触发器结束和最大处理条数限制
    storyline_synthesis_max_inputs_per_maintenance: 32
    storyline_synthesis_max_retries: 3
    provider: ""
    model: ""
    generation:
      temperature: 0.2
      max_output_tokens: 4000
      enable_thinking: false
  memory_predicate_similarity_threshold: 0.8
  memory_recall_max_results: 8
  memory_recall_recent_fallback: true
  embedding:
    provider: "hash"
    model: ""
    dim: 128
  events:
    recall_limit: 6
    world_query_chunks: 6 # 从当前 world/chat 中提取参与被动召回的高质量文本片段上限
    cognition_query_chunks: 3 # 从最近内心流中提取参与被动召回的片段上限

# --- 主动思考（think_deeply 工具） ---
# 主模型可调用 think_deeply，把一个念头丢给“内在思考子模型”。
# 这里也使用显式 provider + model 绑定。
slow_thinking:
  enabled: true
  provider: "siliconflow"
  model: "Pro/zai-org/GLM-5"
  generation:
    temperature: 1.0
    max_output_tokens: 10000
    enable_thinking: true

# ══════════════════════════════════════════
#  平台集成
# ══════════════════════════════════════════
platforms:
  qq:
    enabled: true # 设为 true 启用 QQ 平台连接
    adapter:
      type: "auto" # 可选: auto / napcat / llonebot
      name: "Auto"
      debug_only: false # 设为 true 时只广播 XML 调试，完全不调用 LLM
      reverse_ws:
        host: "127.0.0.1" # WebSocket 服务监听地址
        port: 8078 # WebSocket 服务端口（QQ adapter 配置反向 WS 连接到这里）
    access:
      # enabled: true  = 白名单模式，只响应列表内的用户/群组
      # enabled: false = 自由模式，好友/已加入群均可作为会话
      whitelist:
        enabled: true
        private_users:  # 私聊白名单，填 QQ 号
          - "1111111111"
        group_ids:      # 群聊白名单，填群号
          - "1111111111"
    attention:
      respond_to_self_name: true # 群聊文本直接包含 self_name 时是否主动回复
    recovery:
      enabled: true # 连接恢复后自动补拉离线消息与更早历史
      page_size: 50 # 每次向 QQ adapter 拉取多少条消息
      max_pages_per_session: 0 # 每个会话每轮最多翻多少页；0 = 不限
      backfill_history: true # 是否持续向更早历史回填，直到没有更早记录
      seed_from_whitelist: true # 即使本地还没有会话，也为白名单会话建立历史镜像
    supervisor:
      enabled: false
      command: ""
      args: []
      cwd: ""
      stop_command: ""
      stop_image_names: []
      stop_path_filter: ""
      force_kill_by_image_name: false
      stop_grace_seconds: 3
      cooldown_seconds: 300
      max_attempts_per_hour: 4
      recovery_grace_seconds: 45
      qrcode_globs: []

# ══════════════════════════════════════════
#  Vision Bridge（视觉桥）
#  当主模型不支持视觉（vision: false）或需要精查图片细节时，
#  由独立 VLM 生成图片描述并缓存到 data/image_cache/。
#  同一张图（即便经过 JPEG 重压缩）只描述一次，后续复用。
# ══════════════════════════════════════════
vision_bridge:
  enabled: false             # true = 启用自动描述；false = 只做 pHash 落盘，不调 VLM
  model: "Qwen/Qwen2-VL-7B-Instruct"
  base_url: "https://api.siliconflow.cn/v1"
  api_key_env: "SILICONFLOW_API_KEY"     # .env 中对应的环境变量名
  describe_prompt: "请用2-4句话描述这张图片的主要内容，重点识别其中的文字、数字、人物、场景和关键视觉元素。描述要简洁、客观。"
  enable_thinking: false      # 是否向支持的 OpenAI 兼容 API 传递 enable_thinking
  temperature: 0.3            # 视觉桥模型温度
  max_output_tokens: 512      # 视觉桥模型最大输出 token 数
  similarity_threshold: 10  # 感知哈希汉明距离阈值，≤此值视为同一张图（0=精确匹配）
  # 缓存清理策略（每次启动时执行一次）
  cache_eviction:
    max_age_days: 30         # 超过此天数的缓存图片将被删除，0 = 不按时间清理
    max_size_mb: 500         # 缓存目录总大小上限(MB)，超出则淘汰最旧的条目，0 = 不限大小

